from collections.abc import Sequence
from typing import Any

BACKEND: str
MAX_DEPTH: int

class NativeSchema:
    def __init__(
        self, kind: str, children: Sequence[NativeSchema], args: Sequence[Any],
    ) -> None: ...
    @property
    def kind(self) -> str: ...
    @property
    def has_async(self) -> bool: ...
    @property
    def children(self) -> tuple[NativeSchema, ...]: ...
    @property
    def args(self) -> tuple[Any, ...]: ...
    def parse(
        self, value: Any, missing: Any, issue_type: type[Any], error_type: type[Exception],
    ) -> Any: ...
    def parse_json(self, data: str | bytes | bytearray) -> tuple[bool, Any]: ...

class NativeIssueBundle:
    def to_raw(self) -> tuple[tuple[Any, ...], ...]: ...

class AsyncSession:
    def __init__(
        self,
        node: NativeSchema,
        value: Any,
        missing: Any,
        issue_type: type[Any],
        error_type: type[Exception],
    ) -> None: ...
    def start(self) -> tuple[bool, Any]: ...
    def resume_value(self, token: int, value: Any) -> tuple[bool, Any]: ...
    def resume_error(self, token: int, error: BaseException) -> tuple[bool, Any]: ...
    def close(self) -> None: ...
